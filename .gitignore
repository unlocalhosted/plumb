node_modules
dist/
.plumb-cache/
/bench/metalui/.cache/

# Full benchmark reports are regenerated by bench/metalui/*.mjs
/bench/metalui/*.cold.json
/bench/metalui/*.warm.json
/bench/metalui/layer1.json
/bench/metalui/layer5.parity.json
/bench/metalui/layer4.decisions.json
/fixtures/.cache-direct/
*.tgz

/fixtures/.verify-frozen/

# React Plumber generated caches
**/.plumber/cache/
**/.plumb/cache/

/overlay/showcase/.probe-cache/
/docs/design/references/

# bench/locate: throwaway hosts and the one tool it installs
/bench/locate/.work/
/bench/locate/.tools/

# bench/locate: real Next apps cloned for the nextapps corpus (never committed; tailwindcss.com is education-only)
/bench/locate/.corpus/
.test-logs/

# state oracle (tools/sm): the log and cache are local
/.state/log*.jsonl
/.state/open.json
/.state/cache/
.test-logs-remote/
.test-times.json

# film drafts: one cheap run each, for the story and camera reviews; never published
docs/films/*-draft/
/bench/tells/report.json

# organism generator: screenshots and sidecars (absolute values and text from other products) stay local
/generator/shots/
/generator/sidecars/
/generator/reads/
/generator/library/cache/
/generator/data/traces/
/generator/sandbox/node_modules/
/generator/sandbox/parts/
/generator/sandbox/themes.generated.css
/generator/sandbox/installed.json
/generator/sandbox/results.jsonl
/generator/sandbox/shots/
/generator/sandbox/declared-deps.txt

# plumber's craft engine, built for the site by web/scripts/engine.mjs
/web/public/engine/

# judged set (bench/judged): what a judge said and the screens as data stay local; the app may be private
/bench/judged/sets/*/judgements/
/bench/judged/sets/*/screens/
/bench/judged/sets/*/set-aside/
