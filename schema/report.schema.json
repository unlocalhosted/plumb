{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "React Plumber report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "root", "config", "tailwind", "files", "findings", "coverage", "timing", "classes", "notes", "declarations", "stylesheets", "moduleGraph", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "react-plumber" }, "version": { "type": "string" } }
    },
    "root": { "type": "string" },
    "configHints": {
      "type": "object", "additionalProperties": false,
      "properties": { "type": { "type": "string" } }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "inferred"],
      "properties": { "path": { "type": ["string", "null"] }, "inferred": { "type": "boolean" } }
    },
    "tailwind": {
      "type": "object", "additionalProperties": false,
      "required": ["entry", "version"],
      "properties": { "entry": { "type": ["string", "null"] }, "version": { "type": ["string", "null"] } }
    },
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["tsx", "jsx", "css", "other"],
      "properties": {
        "tsx": { "$ref": "#/$defs/count" }, "jsx": { "$ref": "#/$defs/count" },
        "css": { "$ref": "#/$defs/count" }, "other": { "$ref": "#/$defs/count" }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "habits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "reason", "severity", "enabled", "breaks"], "properties": {"id": {"type": "string"}, "reason": {"type": "string"}, "severity": {"enum": ["error", "warn", "info"]}, "enabled": {"type": "boolean"}, "breaks": {"type": ["integer", "null"], "minimum": 0}}}},
    "presets": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "source", "decisions", "exported", "components", "imitation", "habits", "markers"],
        "properties": {
          "name": {"type": "string"}, "source": {"type": "string"}, "decisions": {"$ref": "#/$defs/count"}, "exported": {"$ref": "#/$defs/count"},
          "components": {"type": "object", "additionalProperties": false, "required": ["from", "contracts"], "properties": {"from": {"$ref": "#/$defs/strings"}, "contracts": {"$ref": "#/$defs/strings"}}},
          "imitation": {"$ref": "#/$defs/strings"}, "habits": {"$ref": "#/$defs/strings"}, "markers": {"$ref": "#/$defs/strings"}
        }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "decisionInventory": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "deadDecisions": {
      "type": "object", "additionalProperties": false,
      "patternProperties": {
        "^(spacing|color|radius|type|motion|elevation|size|z|opacity)$": {
          "type": "object", "additionalProperties": false, "required": ["total", "used", "exported", "dead"],
          "properties": { "total": { "$ref": "#/$defs/count" }, "used": { "$ref": "#/$defs/count" }, "exported": { "$ref": "#/$defs/count" }, "dead": { "$ref": "#/$defs/count" } }
        }
      }
    },
    "imitationSuggestions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["component", "fingerprint", "rawElements"],
        "properties": { "component": { "$ref": "#/$defs/component" }, "fingerprint": { "$ref": "#/$defs/strings" }, "rawElements": { "$ref": "#/$defs/count" }, "notes": { "$ref": "#/$defs/strings" } }
      }
    },
    "ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["exists", "path", "entries", "new", "debt", "exceptions", "outOfScope", "stale", "growth", "message"],
      "properties": {
        "exists": { "type": "boolean" }, "path": { "type": "string" }, "message": { "type": "string" },
        "entries": { "$ref": "#/$defs/count" }, "new": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" },
        "exceptions": { "$ref": "#/$defs/count" }, "outOfScope": { "$ref": "#/$defs/count" }, "stale": { "$ref": "#/$defs/count" }, "growth": { "$ref": "#/$defs/count" }
      }
    },
    "notes": { "$ref": "#/$defs/strings" },
    "declarations": { "type": "array", "items": { "$ref": "#/$defs/declaration" } },
    "moduleGraph": {
      "type": "object", "additionalProperties": false,
      "required": ["modules", "followed", "cssFiles", "cacheHits", "cacheMisses", "parseMs", "totalMs"],
      "properties": {
        "modules": { "$ref": "#/$defs/count" }, "followed": { "$ref": "#/$defs/count" },
        "cssFiles": { "$ref": "#/$defs/count" }, "cacheHits": { "$ref": "#/$defs/count" }, "cacheMisses": { "$ref": "#/$defs/count" },
        "parseMs": { "type": "number", "minimum": 0 }, "totalMs": { "type": "number", "minimum": 0 }
      }
    },
    "stylesheets": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "sourceOrigin", "reached"],
        "properties": {
          "file": { "type": "string" }, "sourceOrigin": { "enum": ["project", "framework"] },
          "package": { "type": "string" },
          "reached": { "type": "array", "items": { "$ref": "#/$defs/reach" } }
        }
      }
    },
    "classes": {
      "type": "object", "additionalProperties": false, "required": ["unique", "opaque"],
      "properties": { "unique": { "$ref": "#/$defs/count" }, "opaque": { "$ref": "#/$defs/count" } }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["existence", "declarations", "stylesheets", "inline", "spacing", "color", "radius", "type", "motion", "elevation", "z"],
      "properties": {
        "ownership": { "$ref": "#/$defs/ownershipCoverage" },
        "spacing": {
          "type": "object", "additionalProperties": false, "required": ["fromDecisions", "total", "findings"],
          "properties": { "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" }, "exceptions": { "$ref": "#/$defs/count" } }
        },
        "color": {
          "type": "object", "additionalProperties": false, "required": ["fromDecisions", "total", "findings"],
          "properties": { "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" }, "exceptions": { "$ref": "#/$defs/count" } }
        },
        "radius": {
          "type": "object", "additionalProperties": false, "required": ["fromDecisions", "total", "findings"],
          "properties": { "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" }, "exceptions": { "$ref": "#/$defs/count" } }
        },
        "type": {
          "type": "object", "additionalProperties": false, "required": ["fromDecisions", "total", "findings"],
          "properties": { "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" }, "exceptions": { "$ref": "#/$defs/count" } }
        },
        "motion": {
          "type": "object", "additionalProperties": false, "required": ["fromDecisions", "total", "findings"],
          "properties": { "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" }, "exceptions": { "$ref": "#/$defs/count" } }
        },
        "elevation": {
          "type": "object", "additionalProperties": false, "required": ["fromDecisions", "total", "findings"],
          "properties": { "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" }, "exceptions": { "$ref": "#/$defs/count" } }
        },
        "z": {
          "type": "object", "additionalProperties": false, "required": ["fromDecisions", "total", "findings"],
          "properties": { "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" }, "exceptions": { "$ref": "#/$defs/count" } }
        },
        "existence": {
          "type": "object", "additionalProperties": false, "required": ["total", "dead", "deadVars"],
          "properties": { "total": { "$ref": "#/$defs/count" }, "dead": { "$ref": "#/$defs/count" }, "deadVars": { "$ref": "#/$defs/count" } }
        },
        "declarations": {
          "type": "object", "additionalProperties": false, "required": ["class","arbitrary","stylesheet","apply","inline","custom-property","keyframes"],
          "properties": { "class": { "$ref": "#/$defs/count" }, "arbitrary": { "$ref": "#/$defs/count" }, "stylesheet": { "$ref": "#/$defs/count" }, "apply": { "$ref": "#/$defs/count" }, "inline": { "$ref": "#/$defs/count" }, "custom-property": { "$ref": "#/$defs/count" }, "keyframes": { "$ref": "#/$defs/count" } }
        },
        "stylesheets": {
          "type": "object", "additionalProperties": false, "required": ["entry","import","reference","side-effect","module","source","jsx-style"],
          "properties": { "entry": { "$ref": "#/$defs/count" }, "import": { "$ref": "#/$defs/count" }, "reference": { "$ref": "#/$defs/count" }, "side-effect": { "$ref": "#/$defs/count" }, "module": { "$ref": "#/$defs/count" }, "source": { "$ref": "#/$defs/count" }, "jsx-style": { "$ref": "#/$defs/count" } }
        },
        "inline": {
          "type": "object", "additionalProperties": false, "required": ["sites","literalSites","opaque","fullyOpaque","spreads"],
          "properties": { "sites": { "$ref": "#/$defs/count" }, "literalSites": { "$ref": "#/$defs/count" }, "opaque": { "$ref": "#/$defs/count" }, "fullyOpaque": { "$ref": "#/$defs/count" }, "spreads": { "$ref": "#/$defs/count" } }
        }
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["totalMs", "phases", "cacheHits", "cacheMisses"],
      "properties": {
        "totalMs": { "type": "number", "minimum": 0 },
        "cacheHits": { "$ref": "#/$defs/count" }, "cacheMisses": { "$ref": "#/$defs/count" },
        "phases": {
          "type": "object", "additionalProperties": false,
          "required": ["discover", "parse", "collect", "load", "compile", "stylesheets", "inline", "decisions", "provenance"],
          "properties": {
            "discover": { "type": "number", "minimum": 0 }, "parse": { "type": "number", "minimum": 0 },
            "collect": { "type": "number", "minimum": 0 }, "load": { "type": "number", "minimum": 0 },
            "compile": { "type": "number", "minimum": 0 },
            "stylesheets": { "type": "number", "minimum": 0 }, "inline": { "type": "number", "minimum": 0 },
            "decisions": { "type": "number", "minimum": 0 }, "provenance": { "type": "number", "minimum": 0 }, "ownership": { "type": "number", "minimum": 0 }, "habits": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object", "additionalProperties": false, "required": ["name", "source", "variants", "roots"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "object", "additionalProperties": false, "required": ["file", "line"], "properties": { "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } } },
        "variants": { "type": "object", "additionalProperties": { "$ref": "#/$defs/strings" } },
        "roots": { "type": "object", "additionalProperties": false, "required": ["elements", "classes"], "properties": { "elements": { "$ref": "#/$defs/strings" }, "classes": { "$ref": "#/$defs/strings" } } }
      }
    },
    "ownershipCoverage": {
      "type": "object", "additionalProperties": false, "required": ["callerDeclarations", "findings", "heuristicFindings", "byFamily"],
      "properties": {
        "callerDeclarations": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" }, "heuristicFindings": { "$ref": "#/$defs/count" },
        "byFamily": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["total", "allowed", "findings"], "properties": { "total": { "$ref": "#/$defs/count" }, "allowed": { "$ref": "#/$defs/count" }, "findings": { "$ref": "#/$defs/count" } } } }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "reach": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["entry", "import", "reference", "side-effect", "module", "source", "jsx-style"] },
        "from": { "type": "string" }, "specifier": { "type": "string" }
      }
    },
    "strings": { "type": "array", "items": { "type": "string" } },
    "family": { "enum": ["spacing", "color", "radius", "type", "motion", "elevation", "size", "z", "opacity"] },
    "site": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "line", "column", "text"],
      "properties": {
        "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }, "text": { "type": "string" }, "anchor": { "type": "string" }, "inScope": { "type": "boolean" },
        "ledger": {
          "type": "object", "additionalProperties": false, "required": ["key", "status"],
          "properties": {
            "key": { "type": "string" }, "status": { "enum": ["new", "debt", "exception"] }, "why": { "type": "string" }
          }
        }
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["media", "pseudo", "selector", "container", "supports", "branch", "layer"] },
        "text": { "type": "string" }
      }
    },
    "declaration": {
      "type": "object", "additionalProperties": false,
      "required": ["prop", "value", "refs", "when", "site", "owner", "origin"],
      "properties": {
        "prop": { "type": "string" }, "value": { "type": "string" }, "resolved": { "type": "string" },
        "refs": { "$ref": "#/$defs/strings" },
        "when": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "site": { "$ref": "#/$defs/site" },
        "owner": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": { "kind": { "enum": ["element", "component"] }, "name": { "type": "string" } }
        },
        "origin": { "enum": ["class", "arbitrary", "stylesheet", "apply", "inline", "custom-property", "keyframes"] },
        "sourceOrigin": { "enum": ["project", "framework"] }, "package": { "type": "string" },
        "authoredValue": { "type": "boolean" }, "decisionRefs": { "$ref": "#/$defs/strings" }, "authoredCss": { "type": "string" },
        "opaque": { "enum": ["dynamic-value", "dynamic-class", "spread"] }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "name", "value", "refs", "origin", "tier", "why", "source"],
      "properties": {
        "exported": { "type": "boolean" },
        "family": { "$ref": "#/$defs/family" }, "name": { "type": "string" }, "value": { "type": "string" }, "resolved": { "type": "string" },
        "refs": { "$ref": "#/$defs/strings" }, "origin": { "enum": ["project", "framework", "inferred"] },
        "tier": { "enum": ["primitive", "semantic"] }, "why": { "type": "string" }, "groupWhy": { "type": "string" }, "use": { "type": "object", "additionalProperties": false, "required": ["css"], "properties": { "class": { "type": "string" }, "css": { "type": "string" } } }, "source": { "type": "object", "additionalProperties": false, "required": ["file", "line"], "properties": { "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } } }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "allOf": [{ "if": { "not": { "required": ["choices"] } }, "then": { "required": ["action"] } }],
      "required": ["key", "rule", "family", "severity", "sites", "declaration", "decisions", "title", "because", "accept", "why", "fix"],
      "properties": {
        "key": { "type": "string" }, "rule": { "type": "string" }, "family": { "type": "string" },
        "severity": { "enum": ["info", "warn", "error"] },
        "sites": { "type": "array", "items": { "$ref": "#/$defs/site" } },
        "declaration": { "$ref": "#/$defs/declaration" },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "title": { "type": "string", "minLength": 1 }, "because": { "type": "string", "minLength": 1 },
        "action": { "type": "string" }, "accept": { "type": "string" },
        "edits": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["site", "text"], "properties": { "site": { "$ref": "#/$defs/site" }, "text": { "type": "string" }, "token": { "type": "string" } } } },
        "choices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } },
        "why": { "type": "string" }, "fix": { "type": "string" },
        "variable": {
          "type": "object", "additionalProperties": false, "required": ["name", "useCount"],
          "properties": { "name": { "type": "string" }, "useCount": { "$ref": "#/$defs/count" } }
        },
        "status": { "enum": ["new", "debt", "exception", "out-of-scope"] },
        "ledgerKeys": { "$ref": "#/$defs/strings" },
        "occurrences": { "type": "array", "items": { "$ref": "#/$defs/declaration" } },
        "component": { "$ref": "#/$defs/component" }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["fromDecisions", "total", "findings", "debt", "exceptions"],
      "properties": {
        "fromDecisions": { "$ref": "#/$defs/count" }, "total": { "$ref": "#/$defs/count" },
        "findings": { "$ref": "#/$defs/count" }, "debt": { "$ref": "#/$defs/count" },
        "exceptions": { "$ref": "#/$defs/count" }
      }
    }
  }
}
