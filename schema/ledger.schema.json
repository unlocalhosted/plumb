{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One React Plumber ledger JSONL entry",
  "type": "object",
  "required": ["key", "kind"],
  "properties": {
    "key": { "type": "string", "minLength": 1 },
    "v": { "type": "integer", "minimum": 1, "description": "The format version that wrote the line; missing on lines written before versions" },
    "kind": { "enum": ["debt", "exception", "decision", "declined"] },
    "count": { "type": "integer", "minimum": 1 },
    "resolved": { "type": "string" }, "why": { "type": "string" },
    "on": { "type": "string" }, "by": { "type": "string" }, "inferred": { "type": "boolean" },
    "rule": { "type": "string" }, "family": { "type": "string" }, "owner": { "type": "string" },
    "prop": { "type": "string" }, "authored": { "type": "string" }, "path": { "type": "string" }, "anchor": { "type": "string" },
    "value": { "type": "string" }, "refs": { "type": "array", "items": { "type": "string" } },
    "origin": { "type": "string" }, "tier": { "type": "string" }
  }
}
